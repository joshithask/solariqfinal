:root {
  --navy: #0b1220;
  --navy-card: #121b2e;
  --amber: #f5a524;
  --text: #e6e9f0;
  --text-dim: #8b93a7;
  --border: #223049;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--navy);
  color: var(--text);
  font-family: "Segoe UI", system-ui, sans-serif;
}

.page {
  max-width: 720px;
  margin: 0 auto;
  padding: 40px 20px 80px;
}

.header {
  text-align: center;
  margin-bottom: 32px;
}

.header h1 {
  font-size: 2.4rem;
  letter-spacing: 1px;
  margin: 0;
}

.accent { color: var(--amber); }

.tagline {
  color: var(--text-dim);
  font-style: italic;
  margin-top: 6px;
}

.card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px;
  margin-bottom: 20px;
}

.form { display: flex; flex-direction: column; gap: 16px; }

.dropzone {
  border: 2px dashed var(--border);
  border-radius: 12px;
  min-height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--text-dim);
  cursor: pointer;
  overflow: hidden;
}

.dropzone:hover { border-color: var(--amber); }

.preview {
  width: 100%;
  max-height: 260px;
  object-fit: cover;
}

.row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.row input {
  flex: 1;
  min-width: 140px;
}

input {
  background: #0e1626;
  border: 1px solid var(--border);
  color: var(--text);
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 0.95rem;
}

input::placeholder { color: var(--text-dim); }

.primary-btn {
  background: var(--amber);
  color: #1a1200;
  font-weight: 700;
  border: none;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 1rem;
}

.primary-btn:disabled { opacity: 0.6; cursor: not-allowed; }

.ghost-btn {
  background: transparent;
  border: 1px solid var(--amber);
  color: var(--amber);
  border-radius: 8px;
  padding: 10px 14px;
  cursor: pointer;
  white-space: nowrap;
}

.error {
  color: #ff6b6b;
  font-size: 0.9rem;
}

.results { display: flex; flex-direction: column; }

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 16px;
  margin-top: 12px;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-label {
  color: var(--text-dim);
  font-size: 0.8rem;
}

.stat-value {
  font-size: 1.3rem;
  font-weight: 700;
}

.stat-value.accent { color: var(--amber); }

.fine-print {
  color: var(--text-dim);
  font-size: 0.8rem;
  margin-top: 14px;
}

.report-text {
  line-height: 1.6;
  color: var(--text);
}
