solar_calc.py

Estimates solar panel capacity, annual generation, cost savings, and CO2
reduction from a usable roof area, using real location-based solar
irradiance data pulled from the free Open-Meteo API (no key required).
"""

import requests

# --- Standard assumptions (documented for judges in README) ---
PANEL_DENSITY_KW_PER_M2 = 0.2      # ~200 Wp panels, standard packing density
PERFORMANCE_RATIO = 0.75           # inverter/wiring/soiling/temperature losses
DEFAULT_TARIFF_RS_PER_KWH = 8.0    # average Indian residential grid tariff
GRID_EMISSION_FACTOR_KG_PER_KWH = 0.82  # India grid average (CEA baseline)


def get_avg_daily_irradiance_kwh_m2(lat: float, lon: float) -> float:
    """
    Fetch daily shortwave solar radiation sum (MJ/m2) from Open-Meteo's
    forecast API, averaged over the available forecast window, and convert
    to kWh/m2/day (1 kWh = 3.6 MJ).
    Falls back to a conservative default for northern India if the API
    call fails, so the demo never hard-crashes without internet access.
    """
    try:
        url = (
            "https://api.open-meteo.com/v1/forecast"
            f"?latitude={lat}&longitude={lon}"
            "&daily=shortwave_radiation_sum&timezone=auto"
        )
        resp = requests.get(url, timeout=8)
        resp.raise_for_status()
        data = resp.json()
        values_mj = data["daily"]["shortwave_radiation_sum"]
        values_mj = [v for v in values_mj if v is not None]
        if not values_mj:
            raise ValueError("empty irradiance series")
        avg_mj = sum(values_mj) / len(values_mj)
        return round(avg_mj / 3.6, 2)
    except Exception:
        return 5.2  # kWh/m2/day, reasonable default for much of India


def calculate_solar_potential(
    usable_area_m2: float,
    lat: float,
    lon: float,
    tariff_rs_per_kwh: float | None = None,
) -> dict:
    tariff = tariff_rs_per_kwh or DEFAULT_TARIFF_RS_PER_KWH

    daily_irradiance = get_avg_daily_irradiance_kwh_m2(lat, lon)

    capacity_kw = round(usable_area_m2 * PANEL_DENSITY_KW_PER_M2, 2)
    annual_generation_kwh = round(
        capacity_kw * daily_irradiance * 365 * PERFORMANCE_RATIO, 0
    )
    annual_savings_rs = round(annual_generation_kwh * tariff, 0)
    annual_co2_reduction_kg = round(
        annual_generation_kwh * GRID_EMISSION_FACTOR_KG_PER_KWH, 0
    )

    return {
        "daily_irradiance_kwh_m2": daily_irradiance,
        "estimated_capacity_kw": capacity_kw,
        "annual_generation_kwh": annual_generation_kwh,
        "annual_savings_rs": annual_savings_rs,
        "annual_co2_reduction_kg": annual_co2_reduction_kg,
        "tariff_used_rs_per_kwh": tariff,
    }
